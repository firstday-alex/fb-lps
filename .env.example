META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
SESSION_SECRET=a_random_string_for_session_signing
BASE_URL=http://localhost:3000

# Shared password for the whole app. Everything except /login is behind it.
# Unset locally = no gate (with a console warning); unset on Vercel = the app
# refuses to serve, so it can't be exposed by a missing variable.
# Changing this signs everyone out, because the session cookie is keyed on it.
APP_PASSWORD=pick_a_shared_password

# Optional. When set, the Vercel cron for the daily report must send
# `Authorization: Bearer $CRON_SECRET`; without it the gate falls back to
# trusting Vercel's own x-vercel-cron header.
CRON_SECRET=

SHOPIFY_URL=your-store.myshopify.com
SHOPIFY_TOKEN=shpat_your_admin_api_token
